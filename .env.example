# Supabase project (Project Settings -> API). The anon key is safe in the browser; RLS protects writes.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Worker that stores uploads in R2 (workers/uploads)
VITE_UPLOADS_URL=https://portfolio-uploads.YOUR-SUBDOMAIN.workers.dev

# Your live site address, no trailing slash. Used for link previews (WhatsApp, LinkedIn) and the sitemap.
VITE_SITE_URL=https://your-domain.com
